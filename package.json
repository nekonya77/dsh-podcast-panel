{
  "name": "dsh-podcast-panel",
  "version": "0.1.1",
  "description": "DSH 侧栏播客面板：订阅 RSS、倍速播放、记住进度、三行摘要。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "clair0314",
  "homepage": "https://github.com/nekonya77/dsh-podcast-panel",
  "bugs": {
    "url": "https://github.com/nekonya77/dsh-podcast-panel/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "podcast",
    "rss",
    "audio"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekonya77/dsh-podcast-panel.git"
  }
}
